---
/* Arched frame for a photo. Shows an embossed emblem until a real photo
   is supplied. To use a real photo, pass `src` (a file in /public/assets/photos/)
   and a descriptive `alt`, e.g.
   <PhotoPlaceholder src="assets/photos/franccesca.jpg" alt="Franccesca at her desk" label="photo of Franccesca" /> */
import Brand from './Brand.astro';
import { url } from '../site.config';
interface Props { label: string; src?: string; alt?: string; class?: string }
const { label, src, alt = '', class: className = '' } = Astro.props;
---
<figure class={`arch ${className}`}>
  {src ? (
    <img src={url(src)} alt={alt} width="800" height="1000" loading="lazy" decoding="async" />
  ) : (
    <div class="arch__ph" role="img" aria-label={`Photo coming soon: ${label}`} data-placeholder={label}>
      <Brand name="emblem" class="emboss arch__emblem" />
      <span class="arch__caption">Photo coming soon</span>
    </div>
  )}
</figure>

<style>
  .arch {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: 999px 999px var(--radius-lg) var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
    background: var(--tb-paper);
  }
  .arch::after {
    content: '';
    position: absolute;
    inset: 0.6rem;
    border: 1px solid rgb(255 255 255 / 0.65);
    border-radius: inherit;
    pointer-events: none;
  }
  .arch img { width: 100%; height: 100%; object-fit: cover; }
  .arch__ph {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    background:
      radial-gradient(circle at 30% 18%, rgb(255 255 255 / 0.8), transparent 55%),
      linear-gradient(160deg, #E6E2D7, #D6D3C9);
  }
  .arch__ph :global(.arch__emblem) { width: 34%; color: #E4E0D5; }
  .arch__caption {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tb-slate);
  }
</style>
