---
/* Hero illustration: a SAMPLE monthly summary card, showing what
   "clear books" feel like. All figures are made-up examples and the card
   is labelled "Sample" on screen. Not a real client.
   Edit the numbers below if you like; keep them obviously illustrative. */
import Brand from './Brand.astro';
import Icon from './Icon.astro';

const month = 'This month';
const rows = [
  { label: 'Money in', value: '$8,420', tone: 'in' },
  { label: 'Money out', value: '$5,130', tone: 'out' },
];
const kept = '$3,290';
// Six-month bar heights (0–100) for the little chart.
const bars = [46, 58, 52, 70, 64, 82];
---
<div class="snap" aria-label="Sample monthly summary, for illustration" role="img">
  <!-- Receipts drifting behind the card -->
  <div class="snap__receipt snap__receipt--a" aria-hidden="true">
    <span></span><span></span><span></span><span class="short"></span>
  </div>
  <div class="snap__receipt snap__receipt--b" aria-hidden="true">
    <span></span><span class="short"></span><span></span>
  </div>

  <div class="snap__card" aria-hidden="true">
    <div class="snap__top">
      <span class="snap__kicker">Your month at a glance</span>
      <span class="badge badge--soft">Sample</span>
    </div>
    <p class="snap__month">{month}</p>

    <div class="snap__rows">
      {rows.map((r) => (
        <div class={`snap__row snap__row--${r.tone}`}>
          <span>{r.label}</span><strong>{r.value}</strong>
        </div>
      ))}
      <div class="snap__row snap__row--kept">
        <span>Left over</span><strong>{kept}</strong>
      </div>
    </div>

    <div class="snap__chart">
      {bars.map((h, i) => <span style={`--h:${h}%; --i:${i}`}></span>)}
    </div>

    <ul class="snap__checks">
      <li><Icon name="check" /> Every transaction sorted</li>
      <li><Icon name="check" /> Matched to the bank</li>
      <li><Icon name="check" /> Ready for tax time</li>
    </ul>

    <Brand name="emblem" class="snap__seal emboss" />
  </div>
</div>

<style>
  .snap {
    position: relative;
    width: min(100%, 25rem);
    margin-inline: auto;
    padding: 2rem 1rem 1rem;
  }
  .snap__card {
    position: relative;
    z-index: 2;
    background: #F8F6F1;
    border-radius: 18px;
    padding: 1.6rem 1.6rem 1.4rem;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.9) inset,
      0 2px 3px rgb(33 49 63 / 0.06),
      0 40px 70px -30px rgb(33 49 63 / 0.45);
    rotate: -2.5deg;
    animation: snap-float 9s var(--ease-soft) infinite alternate;
  }
  @keyframes snap-float {
    from { transform: translateY(0); }
    to   { transform: translateY(-10px); }
  }
  .snap__top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .snap__kicker { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--tb-slate); }
  .snap__month {
    font-family: var(--font-heading);
    font-size: 2.1rem;
    font-weight: 400;
    line-height: 1.1;
    margin: 0.4rem 0 1rem;
  }
  .snap__rows { display: grid; gap: 0.1rem; }
  .snap__row {
    display: flex;
    justify-content: space-between;
    padding: 0.55rem 0;
    border-bottom: 1px dashed var(--tb-line);
    font-size: 0.95rem;
    color: var(--tb-slate);
  }
  .snap__row strong { color: var(--tb-navy); font-weight: 600; font-variant-numeric: tabular-nums; }
  .snap__row--kept { border-bottom: 0; padding-top: 0.8rem; }
  .snap__row--kept span { color: var(--tb-navy); font-weight: 600; }
  .snap__row--kept strong {
    font-family: var(--font-heading);
    font-size: 1.7rem;
    font-weight: 500;
    line-height: 1;
    color: var(--tb-olive);
  }
  .snap__chart {
    display: flex;
    align-items: flex-end;
    gap: 0.45rem;
    height: 4.5rem;
    margin: 1rem 0 1.1rem;
    padding: 0 0.15rem;
    border-bottom: 1px solid var(--tb-line);
  }
  .snap__chart span {
    flex: 1;
    height: var(--h);
    border-radius: 5px 5px 2px 2px;
    background: linear-gradient(to top, var(--tb-slate), var(--tb-mist));
    transform-origin: bottom;
    animation: bar-grow 1.1s var(--ease) both;
    animation-delay: calc(0.5s + var(--i) * 0.09s);
  }
  .snap__chart span:last-child { background: linear-gradient(to top, var(--tb-olive), #8A8462); }
  @keyframes bar-grow { from { transform: scaleY(0); } }
  .snap__checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; font-size: 0.88rem; color: var(--tb-slate); }
  .snap__checks li { display: flex; align-items: center; gap: 0.5rem; }
  .snap__checks :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
    padding: 0.15rem;
    border-radius: 50%;
    background: rgb(87 82 56 / 0.14);
    color: var(--tb-olive);
    stroke-width: 2.2;
  }
  .snap :global(.snap__seal) {
    position: absolute;
    right: 1.4rem;
    bottom: 1.2rem;
    width: 3.2rem;
    color: #F1EEE6;
    rotate: 8deg;
  }

  /* Paper receipts peeking out behind the card */
  .snap__receipt {
    position: absolute;
    z-index: 1;
    width: 9rem;
    padding: 1.1rem 1rem 1.6rem;
    background: #FBFAF6;
    box-shadow: 0 18px 30px -18px rgb(33 49 63 / 0.4);
    display: grid;
    gap: 0.5rem;
    /* zig-zag torn bottom edge */
    -webkit-mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 12px 100%;
            mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 12px 100%;
    animation: receipt-drift 11s var(--ease-soft) infinite alternate;
  }
  .snap__receipt span { height: 5px; border-radius: 3px; background: var(--tb-line); }
  .snap__receipt span.short { width: 55%; }
  .snap__receipt--a { top: 0; left: -1.5rem; rotate: -14deg; }
  .snap__receipt--b { right: -1.75rem; bottom: 3.5rem; rotate: 11deg; width: 7.5rem; animation-delay: -4s; }
  @keyframes receipt-drift {
    from { transform: translate(0, 0); }
    to   { transform: translate(6px, -12px) rotate(2deg); }
  }
</style>
