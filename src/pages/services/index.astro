---
/* SERVICES PAGE
   Packages and add-ons come from src/data/packages.ts.
   "How it works" steps 2–4 are still TBD: confirm the real process. */
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import CtaBand from '../../components/CtaBand.astro';
import Brand from '../../components/Brand.astro';
import Icon from '../../components/Icon.astro';
import { packages, addOns } from '../../data/packages';
import { site, url, quoteHref } from '../../site.config';

// How it works, step by step. TBD: confirm the real process.
const steps = [
  { icon: 'chat', title: 'Tell me about your business', text: 'Fill out the short quote questionnaire. It takes about two minutes.' },
  { icon: 'user', title: 'We chat', text: '[PLACEHOLDER: e.g. a short call to talk through what you need and answer questions.]' },
  { icon: 'box', title: 'Get set up', text: '[PLACEHOLDER: e.g. what access or documents Franccesca needs to get started.]' },
  { icon: 'calendar', title: 'Your books, every month', text: '[PLACEHOLDER: e.g. what happens each month and when you hear from her.]' },
] as const;

// Visual style per package: light, tinted, dark.
const style = { essentials: 'pkg--light', growth: 'pkg--tint', premium: 'pkg--dark band-navy' };
---
<Base
  title="Services"
  description="Monthly bookkeeping packages for small businesses in Pewaukee, WI and beyond, built on QuickBooks Online. Contact for a quote."
>
  <PageIntro eyebrow="Services" title="Bookkeeping that keeps you <em>in the loop</em>, without the headache.">
    <p class="lede draft">Three monthly packages, built around how many accounts and transactions you have. Tax help is on the way.</p>
    <p class="qbo-pill"><Icon name="shield" /> {site.certification} · Books kept in QuickBooks Online</p>
  </PageIntro>

  <!-- ============ PACKAGES ============ -->
  <section class="section" aria-labelledby="packages-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Monthly packages</p>
        <h2 id="packages-title" class="press">Pick the fit for <em>your business</em></h2>
        <p class="lede">Not sure which one? The quote form helps me point you to the right package.</p>
      </div>

      <div class="pkgs">
        {packages.map((p, i) => (
          <article class={`pkg ${style[p.id]}`} data-reveal style={`--d:${i}`} aria-labelledby={`pkg-${p.id}`}>
            <div class="pkg__head">
              <p class="pkg__kicker">Bookkeeping</p>
              <h3 id={`pkg-${p.id}`} class="pkg__name">{p.name.replace('Bookkeeping ', '')}</h3>
              <p class="pkg__price">{p.price || 'Contact for a quote'}</p>
            </div>
            <p class="pkg__ideal"><strong>Ideal for:</strong> {p.idealClient}</p>
            {p.includesFrom && <p class="pkg__from">{p.includesFrom}</p>}
            <ul class="pkg__list">
              {p.included.map((item) => <li><Icon name="check" />{item}</li>)}
            </ul>
            <a class="btn btn--primary pkg__cta" href={url(`${quoteHref}?package=${p.id}`)}>
              Get a quote <span class="arrow" aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>

      <!-- Add-ons -->
      <div class="addons" data-reveal>
        <div class="addons__head">
          <h3>Add-ons</h3>
          <p class="muted">Add to any package.</p>
        </div>
        <ul class="addons__list">
          {addOns.map((a) => (
            <li>
              <span class="addons__name">{a.name}</span>
              <span class="addons__note muted draft">{a.note}</span>
              <span class="addons__price">{a.price || 'Ask for pricing'}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ QUICKBOOKS ONLINE ============ -->
  <section class="section section--paper" aria-labelledby="qbo-title">
    <div class="wrap qbo">
      <div data-reveal>
        <p class="eyebrow">The tools</p>
        <h2 id="qbo-title" class="press">Built on <em>QuickBooks Online</em></h2>
        <p class="lede draft">
          Your books live in QuickBooks Online, so they’re organized, secure and ready whenever you or
          your tax preparer need them.
        </p>
        <p class="draft">
          New to QuickBooks, or using something else? I can set you up or move your records over with the
          set-up and conversion add-on.
        </p>
      </div>
      <div class="qbo__badge" data-reveal="scale" style="--d:1">
        <Brand name="emblem" class="qbo__seal" />
        <p class="qbo__cert">{site.certification}</p>
        <p class="qbo__sub">TrueBranch Accounting</p>
      </div>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="section" aria-labelledby="how-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">How it works</p>
        <h2 id="how-title" class="press">Four simple <em>steps</em></h2>
      </div>
      <ol class="steps" data-reveal="fade">
        {steps.map((s, i) => (
          <li style={`--i:${i}`}>
            <span class="steps__node"><Icon name={s.icon} /></span>
            <span class="steps__n">Step {i + 1}</span>
            <h3>{s.title}</h3>
            <p class={s.text.startsWith('[') ? 'ph' : 'draft'}>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ TAXES ============ -->
  <section class="section section--paper" aria-labelledby="tax-title">
    <div class="wrap">
      <article class="card soon" data-reveal>
        <div class="soon__sprout" aria-hidden="true">
          <svg viewBox="0 0 120 120">
            <path class="soon__soil" d="M18 100 Q60 88 102 100" />
            <path class="soon__stem" d="M60 98 C60 80 60 66 60 50" />
            <path class="soon__leaf soon__leaf--l" d="M60 70 C 44 70 34 60 32 46 C 48 46 58 56 60 70 Z" />
            <path class="soon__leaf soon__leaf--r" d="M60 58 C 74 58 86 48 88 32 C 72 32 62 42 60 58 Z" />
          </svg>
        </div>
        <span class="badge">Coming soon</span>
        <h2 id="tax-title">Tax <em>help</em></h2>
        <p class="draft">
          I’m working on adding tax services. If you’d like to hear when they launch, let me know.
          It only takes a tick on the quote form.
        </p>
        <a class="text-link" href={url(`${quoteHref}?tax=yes`)}>Keep me posted</a>
      </article>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .qbo-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    background: var(--tb-navy);
    color: var(--tb-cream);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .qbo-pill :global(.icon) { width: 1.1rem; height: 1.1rem; }

  /* ---------- Package cards ---------- */
  .pkgs { display: grid; gap: 1.5rem; align-items: stretch; }
  @media (min-width: 62rem) { .pkgs { grid-template-columns: repeat(3, 1fr); } }
  .pkg {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 3.5vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: var(--tb-paper);
    color: var(--tb-navy);
    box-shadow: var(--shadow-lift);
  }
  .pkg--tint { background: var(--pkg-tint, #E1DDC7); }
  :global(html[data-theme='dusty']) .pkg--tint { --pkg-tint: #D6DCE1; }
  .pkg--dark { background: var(--tb-cream); }
  .pkg__head { padding-bottom: 1.25rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--tb-line); }
  .pkg__kicker { margin: 0; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--tb-olive); }
  .pkg__name { font-size: clamp(2rem, 3.5vw, 2.6rem); font-weight: 400; margin: 0.15rem 0 0.4rem; }
  .pkg__price { margin: 0; font-weight: 600; color: var(--tb-slate); }
  .pkg__ideal { font-size: 0.97rem; color: var(--tb-slate); }
  .pkg__ideal strong { color: var(--tb-navy); }
  .pkg__from { font-weight: 600; margin-bottom: 0.6rem; color: var(--tb-olive); }
  .pkg__list { list-style: none; margin: 0 0 2rem; padding: 0; display: grid; gap: 0.65rem; font-size: 0.97rem; }
  .pkg__list li { display: flex; gap: 0.65rem; align-items: flex-start; }
  .pkg__list :global(.icon) {
    width: 1.3rem;
    height: 1.3rem;
    padding: 0.2rem;
    margin-top: 0.1rem;
    border-radius: 50%;
    background: rgb(87 82 56 / 0.16);
    color: var(--tb-olive);
    stroke-width: 2.2;
    flex-shrink: 0;
  }
  .pkg--dark .pkg__list :global(.icon) { background: rgb(234 231 223 / 0.14); }
  .pkg__cta { margin-top: auto; align-self: flex-start; }
  .pkg--dark .pkg__cta { --btn-bg: #EAE7DF; --btn-fg: #21313F; }

  /* ---------- Add-ons ---------- */
  .addons {
    display: grid;
    gap: 1rem 2.5rem;
    margin-top: 2rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    border: 1.5px dashed var(--tb-line);
  }
  @media (min-width: 52rem) { .addons { grid-template-columns: 14rem 1fr; } }
  .addons__head h3 { margin-bottom: 0.2rem; }
  .addons__head p { margin: 0; }
  .addons__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .addons__list li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.15rem 1.5rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--tb-line);
  }
  .addons__list li:last-child { border-bottom: 0; }
  .addons__name { font-weight: 600; }
  .addons__note { grid-row: 2; font-size: 0.93rem; }
  .addons__price { grid-row: 1 / span 2; grid-column: 2; align-self: center; font-weight: 600; color: var(--tb-olive); white-space: nowrap; }

  /* ---------- QuickBooks ---------- */
  .qbo { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  @media (min-width: 56rem) { .qbo { grid-template-columns: 1.4fr 1fr; } }
  .qbo__badge {
    display: grid;
    justify-items: center;
    text-align: center;
    padding: clamp(2rem, 4vw, 3rem);
    border-radius: 50% / 40%;
    background: var(--tb-paper);
    box-shadow: var(--shadow-lift);
    max-width: 22rem;
    margin-inline: auto;
  }
  .qbo__badge :global(.qbo__seal) { width: 4.5rem; color: var(--tb-olive); margin-bottom: 1rem; }
  .qbo__cert { font-family: var(--font-heading); font-size: 1.7rem; line-height: 1.15; margin: 0 0 0.4rem; }
  .qbo__sub { margin: 0; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--tb-slate); }

  /* ---------- Steps timeline ---------- */
  .steps {
    --line: 2px;
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.5rem;
  }
  .steps::before {
    content: '';
    position: absolute;
    left: 1.75rem;
    top: 1.75rem;
    bottom: 1.75rem;
    width: var(--line);
    background: linear-gradient(var(--tb-olive), var(--tb-mist));
    transform-origin: top;
    transition: transform 1.6s var(--ease);
  }
  :global(.reveal-on) .steps:not(.is-in)::before { transform: scaleY(0); }
  .steps li { position: relative; padding-left: 5rem; }
  .steps__node {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--tb-cream);
    color: var(--tb-olive);
    box-shadow: 0 0 0 6px var(--tb-cream), var(--shadow-soft);
    transition: transform 0.6s var(--ease), background-color 0.6s, color 0.6s;
    transition-delay: calc(0.3s + var(--i) * 0.25s);
  }
  :global(.reveal-on) .steps:not(.is-in) .steps__node { transform: scale(0.4); }
  .steps.is-in .steps__node, :global(html:not(.reveal-on)) .steps__node { background: var(--tb-navy); color: var(--tb-cream); }
  .steps__n { display: block; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--tb-olive); margin: 0.2rem 0 0.4rem; }
  .steps h3 { margin-bottom: 0.4rem; }
  .steps p { margin: 0; color: var(--tb-slate); }
  @media (min-width: 60rem) {
    .steps { grid-template-columns: repeat(4, 1fr); gap: 2rem; }
    .steps::before {
      left: 1.75rem;
      right: 1.75rem;
      top: 1.75rem;
      bottom: auto;
      width: auto;
      height: var(--line);
      background: linear-gradient(90deg, var(--tb-olive), var(--tb-mist));
      transform-origin: left;
    }
    :global(.reveal-on) .steps:not(.is-in)::before { transform: scaleX(0); }
    .steps li { padding-left: 0; padding-top: 5rem; }
  }

  /* ---------- Taxes ---------- */
  .soon {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: transparent;
    border: 1.5px dashed var(--tb-line);
    box-shadow: none;
    max-width: 46rem;
  }
  .soon h2 { font-size: clamp(2rem, 4vw, 2.6rem); margin-top: 1rem; }
  .soon__sprout { position: absolute; right: 1.5rem; top: 1.25rem; width: 6.5rem; }
  .soon__sprout svg { overflow: visible; }
  .soon__soil { fill: none; stroke: var(--tb-mist); stroke-width: 2; stroke-linecap: round; }
  .soon__stem { fill: none; stroke: var(--tb-olive); stroke-width: 2.4; stroke-linecap: round; stroke-dasharray: 60; animation: grow-stem 2.4s var(--ease) both 0.3s; }
  .soon__leaf { fill: var(--tb-olive); opacity: 0.85; transform-box: fill-box; animation: grow-leaf 1.4s var(--ease) both; }
  .soon__leaf--l { transform-origin: 100% 100%; animation-delay: 1.4s; }
  .soon__leaf--r { transform-origin: 0% 100%; animation-delay: 1.8s; }
  @keyframes grow-stem { from { stroke-dashoffset: 60; } to { stroke-dashoffset: 0; } }
  @keyframes grow-leaf { from { scale: 0; } }
</style>
