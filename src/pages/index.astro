---
/* HOME PAGE
   All wording here is DRAFT until Franccesca approves it.
   Text in [PLACEHOLDER: ...] still needs real content.
   Wrap a word in <em> inside a heading for the italic olive accent. */
import Base from '../layouts/Base.astro';
import Brand from '../components/Brand.astro';
import Icon from '../components/Icon.astro';
import LeafShadow from '../components/LeafShadow.astro';
import Snapshot from '../components/Snapshot.astro';
import ShoeboxSort from '../components/ShoeboxSort.astro';
import Testimonials from '../components/Testimonials.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, url, quoteHref, serviceArea } from '../site.config';

// The gently scrolling ribbon under the hero.
const ribbon = ['Less stress', 'More clarity', 'Calmer tax time', 'Know where you stand', 'Books you understand', 'Time back for your business'];

const benefits = [
  { icon: 'trend', title: 'Know where you stand', text: 'See what’s coming in, what’s going out, and what’s left, without guessing.' },
  { icon: 'taxcal', title: 'Calmer tax time', text: 'Your records are already organized, so there’s no last-minute scramble.' },
  { icon: 'apart', title: 'Business and personal, kept apart', text: 'A clean line between the two makes everything easier to follow.' },
] as const;
---
<Base
  title={site.name}
  description="Friendly monthly bookkeeping for small business owners. Clear, up-to-date books so you always know where your business stands."
>
  <!-- ============ HERO ============ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__light" aria-hidden="true"></div>
    <LeafShadow />
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="eyebrow" data-reveal>Bookkeeping for small business owners</p>
        <h1 id="hero-title" class="press draft" data-reveal style="--d:1">
          Your books, <em>sorted</em>, so you can get back to your business.
        </h1>
        <p class="lede draft" data-reveal style="--d:2">
          I turn the receipts, bank statements and “I’ll deal with it later” pile into clear,
          up-to-date books you can actually understand.
        </p>
        <div class="btn-row hero__actions" data-reveal style="--d:3">
          <a class="btn btn--primary" href={url(quoteHref)}>Get a quote <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href={url('why-bookkeeping/')}>Why bookkeeping?</a>
        </div>
        <ul class="hero__promises" data-reveal style="--d:4">
          <li><Icon name="user" /> One person, start to finish</li>
          <li><Icon name="chat" /> Plain language, no jargon</li>
          <li><Icon name="heart" /> Zero judgment</li>
        </ul>
      </div>
      <div class="hero__art" data-reveal="fade" style="--d:2">
        <Snapshot />
      </div>
    </div>
  </section>

  <!-- ============ RIBBON ============ -->
  <div class="ribbon" aria-hidden="true">
    <div class="ribbon__track">
      {[0, 1].map(() => (
        <div class="ribbon__set">
          {ribbon.map((word) => (
            <span class="ribbon__item">{word}<Brand name="branch" class="ribbon__sprig" /></span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- ============ WHY BOOKKEEPING (teaser + shoebox demo) ============ -->
  <section class="section" aria-labelledby="why-title">
    <div class="wrap why">
      <div class="why__intro">
        <p class="eyebrow" data-reveal>Why it matters</p>
        <h2 id="why-title" class="press draft" data-reveal style="--d:1">
          If money stuff keeps you up at night, you’re <em>not alone</em>.
        </h2>
        <p class="lede draft" data-reveal style="--d:2">
          Most people don’t start a business to do paperwork. So the numbers pile up, and the
          worry grows quietly in the background.
        </p>
        <p class="draft" data-reveal style="--d:3">
          Bookkeeping is simply keeping a clear, regular record of the money coming in and
          going out. When it’s done every month, a lot of that worry goes away.
        </p>
        <p data-reveal style="--d:4"><a class="text-link" href={url('why-bookkeeping/')}>See how bookkeeping helps</a></p>
      </div>
      <div class="why__demo" data-reveal style="--d:2">
        <ShoeboxSort />
      </div>
    </div>

    <ul class="wrap benefits" role="list">
      {benefits.map((b, i) => (
        <li class="benefit draft" data-reveal style={`--d:${i}`}>
          <span class="icon-bubble"><Icon name={b.icon} /></span>
          <h3>{b.title}</h3>
          <p>{b.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- ============ SERVICES OVERVIEW ============ -->
  <section class="section section--paper services-sec" aria-labelledby="services-title">
    <Brand name="branch" class="services-sec__branch" />
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Services</p>
        <h2 id="services-title" class="press">How I can <em>help</em></h2>
      </div>
      <div class="services">
        <article class="card card--lift service" data-reveal>
          <span class="icon-bubble"><Icon name="receipt" /></span>
          <h3>Monthly bookkeeping</h3>
          <p class="draft">
            Each month I organize your transactions, check your records against your bank
            statements, and send you a simple summary of how the month went.
          </p>
          <p class="ph">[PLACEHOLDER: confirm what’s included each month]</p>
          <a class="text-link" href={url('services/')}>What’s included</a>
        </article>
        <article class="card card--lift service service--soon" data-reveal style="--d:1">
          <div class="service__top">
            <span class="icon-bubble sprout"><Icon name="sprout" /></span>
            <span class="badge">Coming soon</span>
          </div>
          <h3>Tax help</h3>
          <p class="draft">
            Tax services are growing. If you’d like to hear when they launch, just say so when you
            get in touch.
          </p>
          <a class="text-link" href={url(`${quoteHref}?tax=yes`)}>Let me know you’re interested</a>
        </article>
      </div>
      <div class="pricing-note" data-reveal>
        <Brand name="emblem" class="pricing-note__seal" />
        <p class="draft">
          <strong>No one-size price list.</strong> Every business is a little different, so I’ll
          send you a quote that fits yours.
        </p>
        <a class="btn btn--ghost" href={url(quoteHref)}>Contact for a quote</a>
      </div>
    </div>
  </section>

  <!-- ============ TESTIMONIALS (hidden automatically if none are real) ============ -->
  <Testimonials />

  <!-- ============ MEET FRANCCESCA ============ -->
  <section class="section meet-sec" aria-labelledby="meet-title">
    <div class="wrap meet">
      <div class="meet__photo" data-reveal="scale">
        <PhotoPlaceholder label="photo of Franccesca" />
        <Brand name="tbbranch" class="meet__mark" />
      </div>
      <div class="meet__text">
        <p class="eyebrow" data-reveal>Meet your bookkeeper</p>
        <h2 id="meet-title" class="press" data-reveal style="--d:1">Hi, I’m <em>{site.ownerFirstName}</em>.</h2>
        <p class="ph" data-reveal style="--d:2">
          [PLACEHOLDER: two or three sentences from Franccesca about who she is and why she
          started TrueBranch.]
        </p>
        <p class="lede draft" data-reveal style="--d:3">
          You’ll work with me directly, not a call center or a rotating team. Ask me anything,
          even the questions you think are silly.
        </p>
        <p class="meet__sign" data-reveal style="--d:4" aria-hidden="true">{site.ownerFirstName}</p>
        <p class="meet__area muted" data-reveal style="--d:4"><Icon name="pin" /> {serviceArea()}</p>
        <p data-reveal style="--d:5"><a class="text-link" href={url('about/')}>More about me</a></p>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    margin-top: calc(var(--header-h) * -1);
    padding-block: calc(var(--header-h) + clamp(2.5rem, 7vw, 5rem)) clamp(3.5rem, 8vw, 6rem);
  }
  .hero__light {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70rem 36rem at 88% 8%, var(--tb-sun), transparent 62%),
      radial-gradient(40rem 26rem at 5% 95%, rgb(156 165 176 / 0.2), transparent 70%);
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(3rem, 6vw, 4rem);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .hero__inner { grid-template-columns: 1.2fr 1fr; }
  }
  .hero h1 { max-width: 13ch; }
  .hero .lede { max-width: 42ch; }
  .hero__actions { margin: 2.25rem 0 2.5rem; }
  .hero__promises {
    list-style: none;
    margin: 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--tb-line);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    font-size: 0.93rem;
    color: var(--tb-slate);
  }
  .hero__promises li { display: flex; align-items: center; gap: 0.5rem; }
  .hero__promises :global(.icon) { width: 1.2rem; color: var(--tb-olive); }

  /* ---------- Ribbon ---------- */
  .ribbon {
    overflow: hidden;
    background: var(--tb-navy);
    color: var(--tb-cream);
    padding-block: 1.1rem;
    border-block: 1px solid rgb(255 255 255 / 0.06);
  }
  .ribbon__track { display: flex; width: max-content; animation: ribbon 48s linear infinite; }
  .ribbon:hover .ribbon__track { animation-play-state: paused; }
  .ribbon__set { display: flex; }
  .ribbon__item {
    display: inline-flex;
    align-items: center;
    gap: 2.25rem;
    padding-right: 2.25rem;
    font-family: var(--font-heading);
    font-size: clamp(1.3rem, 2.5vw, 1.75rem);
    font-style: italic;
    font-weight: 300;
    white-space: nowrap;
  }
  .ribbon__item :global(.ribbon__sprig) { width: 2.6rem; color: var(--tb-mist); opacity: 0.8; }
  @keyframes ribbon { to { transform: translateX(-50%); } }

  /* ---------- Why ---------- */
  .why { display: grid; gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
  @media (min-width: 60rem) { .why { grid-template-columns: 1fr 1.05fr; } }
  .benefits {
    list-style: none;
    margin-top: clamp(3.5rem, 8vw, 6rem);
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 48rem) { .benefits { grid-template-columns: repeat(3, 1fr); gap: 2.5rem; } }
  .benefit .icon-bubble {
    width: 4.5rem;
    height: 4.5rem;
    margin-bottom: 1.4rem;
    background: var(--tb-navy);
    color: var(--tb-cream);
    box-shadow: 0 14px 26px -14px rgb(33 49 63 / 0.7);
    transition: transform 0.5s var(--ease);
  }
  .benefit .icon-bubble :global(.icon) { width: 2.2rem; height: 2.2rem; stroke-width: 1.3; }
  .benefit:hover .icon-bubble { transform: translateY(-3px) rotate(-4deg); }
  .benefit h3 { margin-bottom: 0.4rem; }
  .benefit p { color: var(--tb-slate); margin: 0; }

  /* ---------- Services ---------- */
  .services-sec { overflow: hidden; }
  .services-sec :global(.services-sec__branch) {
    position: absolute;
    width: 30rem;
    right: -9rem;
    top: 2rem;
    color: var(--tb-olive);
    opacity: 0.07;
    rotate: 20deg;
  }
  .services { display: grid; gap: 1.5rem; }
  @media (min-width: 48rem) { .services { grid-template-columns: 1fr 1fr; } }
  .service { display: flex; flex-direction: column; align-items: flex-start; }
  .service .icon-bubble { margin-bottom: 1.5rem; }
  .service .text-link { margin-top: auto; }
  .service__top { display: flex; justify-content: space-between; align-items: flex-start; width: 100%; }
  .service--soon {
    background: transparent;
    border: 1.5px dashed var(--tb-line);
    box-shadow: none;
  }
  .sprout :global(.icon) { animation: sprout 3.5s var(--ease-soft) infinite alternate; transform-origin: bottom center; }
  @keyframes sprout { from { transform: scale(0.85) rotate(-4deg); } to { transform: scale(1.05) rotate(3deg); } }

  .pricing-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.75rem;
    margin-top: 2.5rem;
    padding: 1.5rem clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--tb-cream);
    box-shadow: inset 0 1px 3px rgb(33 49 63 / 0.08);
  }
  .pricing-note p { flex: 1 1 22rem; margin: 0; color: var(--tb-slate); }
  .pricing-note strong { color: var(--tb-navy); }
  .pricing-note :global(.pricing-note__seal) { width: 2.75rem; color: var(--tb-olive); opacity: 0.8; }

  /* ---------- Meet ---------- */
  .meet { display: grid; gap: clamp(3rem, 7vw, 6rem); align-items: center; }
  .meet__photo { position: relative; width: min(100%, 24rem); margin-inline: auto; }
  .meet__photo :global(.meet__mark) {
    position: absolute;
    width: 46%;
    right: -18%;
    bottom: -6%;
    color: var(--tb-olive);
    background: var(--tb-cream);
    padding: 0.9rem 1rem;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    rotate: -6deg;
  }
  @media (min-width: 56rem) { .meet { grid-template-columns: minmax(18rem, 26rem) 1fr; } }
  .meet__sign {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 2.6rem;
    font-weight: 300;
    color: var(--tb-olive);
    margin: 0.5rem 0 0.75rem;
    line-height: 1;
  }
  .meet__sign::before { content: '— '; opacity: 0.5; }
  .meet__area { display: flex; gap: 0.5rem; font-size: 0.95rem; }
  .meet__area :global(.icon) { width: 1.2rem; margin-top: 0.2rem; color: var(--tb-olive); }

  @media (max-width: 40rem) {
    .meet__photo :global(.meet__mark) { right: -4%; }
  }
</style>
