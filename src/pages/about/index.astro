---
/* ABOUT PAGE
   Franccesca's story is TBD. Replace each [PLACEHOLDER] paragraph with her words.

   PHOTOS: list one or two photos below. The layout adjusts automatically.
   For a real photo, set `src` (file in /public/assets/photos/) and `alt`.
   Delete the second entry if there's only one photo. */
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import CtaBand from '../../components/CtaBand.astro';
import Brand from '../../components/Brand.astro';
import Icon from '../../components/Icon.astro';
import PhotoPlaceholder from '../../components/PhotoPlaceholder.astro';
import { site, serviceArea } from '../../site.config';

const photos: { src?: string; alt?: string; placeholderLabel: string }[] = [
  { placeholderLabel: 'photo of Franccesca' },
  { placeholderLabel: 'optional second photo (e.g. with her husband)' },
];

const values = [
  { icon: 'chat', title: 'Plain language', text: 'No jargon. If a term is unavoidable, I’ll explain it.' },
  { icon: 'heart', title: 'No judgment', text: 'Wherever your books are today is a fine place to start.' },
  { icon: 'user', title: 'One person, start to finish', text: 'You always work with me directly.' },
] as const;
---
<Base
  title="About"
  description="Meet Franccesca Thomas, the Pewaukee, WI bookkeeper behind TrueBranch Accounting."
>
  <PageIntro eyebrow="About" title={`Hi, I’m <em>${site.ownerFirstName}</em>.`} draftTitle={false}>
    <p class="lede draft">I help small business owners feel calm and clear about their money.</p>
  </PageIntro>

  <section class="section about-sec" aria-labelledby="story-title">
    <div class:list={['wrap', 'about', { 'about--two': photos.length > 1 }]}>
      <div class="about__photos" data-reveal="scale">
        {photos.map((p, i) => (
          <PhotoPlaceholder label={p.placeholderLabel} src={p.src} alt={p.alt} class={`about__photo about__photo--${i}`} />
        ))}
        <Brand name="branch" class="about__sprig" />
      </div>

      <div class="about__story">
        <p class="eyebrow" data-reveal>My story</p>
        <h2 id="story-title" class="press" data-reveal style="--d:1">Why I do <em>this work</em></h2>
        <!-- Franccesca's own words, from her notes. -->
        <div data-reveal style="--d:2">
          <p class="lede">
            Based in Pewaukee, WI, I started TrueBranch to support a friend as they launched their own
            businesses. Along the way, I discovered a passion for helping small business owners find
            financial clarity and peace of mind through bookkeeping.
          </p>
          <p>
            As a business owner myself, I understand the time, effort, and heart that go into building
            and growing a business. That’s why I love supporting small and new business owners with
            reliable bookkeeping, giving them the confidence and information they need to focus on
            growing their businesses!
          </p>
        </div>
        <p class="cred" data-reveal style="--d:3"><Icon name="shield" /> {site.certification}, working in QuickBooks Online</p>
        <div class="signoff" data-reveal style="--d:3">
          <Brand name="emblem" class="signoff__seal" />
          <div>
            <p class="signoff__name">{site.ownerFirstName}</p>
            <p class="signoff__role muted">{site.owner}, {site.legalName}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WHAT WORKING WITH ME IS LIKE ============ -->
  <section class="section section--paper" aria-labelledby="values-title">
    <div class="wrap">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow">Working together</p>
        <h2 id="values-title" class="press">What working with me is <em>like</em></h2>
      </div>
      <ul class="values" role="list">
        {values.map((v, i) => (
          <li class="card card--lift value draft" data-reveal style={`--d:${i}`}>
            <span class="icon-bubble"><Icon name={v.icon} /></span>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </li>
        ))}
      </ul>
      <p class="area" data-reveal><Icon name="pin" /> {serviceArea()}</p>
    </div>
  </section>

  <CtaBand heading="I’d love to hear about <em>your business</em>." text="Tell me a little about what you do and where things stand. It takes about two minutes." />
</Base>

<style>
  .about-sec { overflow-x: clip; } /* clip the decorative overhangs without breaking sticky */
  .about { display: grid; gap: clamp(3rem, 7vw, 6rem); align-items: start; }
  @media (min-width: 56rem) {
    .about { grid-template-columns: minmax(18rem, 27rem) 1fr; }
    .about__photos { position: sticky; top: calc(var(--header-h) + 2rem); }
  }
  .about__photos { position: relative; width: min(100%, 27rem); margin-inline: auto; }
  .about--two .about__photos { padding-bottom: 32%; }
  .about--two .about__photos :global(.about__photo--1) {
    position: absolute;
    width: 46%;
    right: -8%;
    bottom: 0;
    border: 6px solid var(--tb-cream);
    rotate: 4deg;
  }
  .about__photos :global(.about__sprig) {
    position: absolute;
    width: 55%;
    left: -14%;
    top: -6%;
    color: var(--tb-olive);
    opacity: 0.75;
    rotate: -18deg;
    pointer-events: none;
  }

  .about__story { padding-top: 1rem; }
  .cred {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--tb-navy);
    color: var(--tb-cream);
    font-size: 0.92rem;
    font-weight: 600;
  }
  .cred :global(.icon) { width: 1.1rem; height: 1.1rem; }
  .signoff {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--tb-line);
  }
  .signoff :global(.signoff__seal) { width: 3.25rem; color: var(--tb-olive); }
  .signoff p { margin: 0; }
  .signoff__name {
    font-family: var(--font-heading);
    font-size: 2.4rem;
    font-style: italic;
    font-weight: 300;
    line-height: 1;
    color: var(--tb-olive);
  }
  .signoff__role { font-size: 0.9rem; margin-top: 0.3rem !important; }

  .values { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; }
  @media (min-width: 48rem) { .values { grid-template-columns: repeat(3, 1fr); } }
  .value .icon-bubble { margin-bottom: 1.25rem; }
  .value p { color: var(--tb-slate); margin: 0; }
  .area { display: flex; justify-content: center; gap: 0.5rem; margin: 2.5rem auto 0; color: var(--tb-slate); text-align: center; }
  .area :global(.icon) { width: 1.2rem; color: var(--tb-olive); margin-top: 0.15rem; }
</style>
