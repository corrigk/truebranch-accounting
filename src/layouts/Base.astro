---
// Fonts are self-hosted (no Google request). Latin only; add other subsets if needed.
import '@fontsource/cormorant-garamond/latin-300.css';
import '@fontsource/cormorant-garamond/latin-300-italic.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource-variable/source-sans-3/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, url } from '../site.config';

interface Props {
  title: string;        // page title, shown in the browser tab and search results
  description: string;  // 1–2 sentence summary for search results and link previews
  noindex?: boolean;    // true to keep a page out of search results
}
const { title, description, noindex: pageNoindex = false } = Astro.props;
const noindex = pageNoindex || site.previewMode;
const fullTitle = title === site.name ? `${site.name} | Bookkeeping for small businesses` : `${title} | ${site.name}`;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = Astro.site && !noindex ? new URL(path, Astro.site).href : undefined;
// Social-share image (public/og-image.png). Link previews need a full URL, so this needs SITE_URL.
const ogImage = Astro.site ? new URL(url('og-image.png'), Astro.site).href : undefined;

// LocalBusiness structured data, only once the city is known.
const localBusiness = site.city
  ? {
      '@context': 'https://schema.org',
      '@type': 'AccountingService',
      name: site.legalName,
      description,
      email: site.email,
      ...(site.phone && { telephone: site.phone }),
      ...(Astro.site && { url: Astro.site.href }),
      areaServed: site.city,
      address: { '@type': 'PostalAddress', addressLocality: site.city, ...(site.region && { addressRegion: site.region }) },
    }
  : null;
---
<!doctype html>
<html lang="en" data-drafts={site.showDraftMarkers ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content="TrueBranch Accounting: calm, clear bookkeeping for small business owners." />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <meta name="theme-color" content="#EAE7DF" />

    <!-- Turn on scroll-reveal animations only when JS runs and motion is welcome. -->
    <script is:inline>
      if ('IntersectionObserver' in window && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        document.documentElement.classList.add('reveal-on');
      }
    </script>

    {localBusiness && <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {site.showDraftMarkers && (
      <aside class="draft-banner" aria-label="Draft notice">
        <p><strong>Draft preview.</strong> Dashed outlines mark draft copy awaiting Franccesca’s approval. [Brackets] mark placeholders.</p>
      </aside>
    )}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll reveal: fade elements with [data-reveal] in as they come into view.
      const root = document.documentElement;
      if (root.classList.contains('reveal-on')) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
